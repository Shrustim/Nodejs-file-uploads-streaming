PORT=3000
AWS_REGION=ap-south-1
S3_BUCKET=your-unique-private-bucket-name
SQLITE_PATH=./data/files.db
MAX_FILE_MB=10
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# AWS credentials: use `aws configure` locally. In AWS use IAM roles.
# Do NOT commit credentials to git.
# Optional: Set this to enable real S3 ObjectCreated -> SQS event worker.
# SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/my-file-upload-queue
